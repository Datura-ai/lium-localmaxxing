# recipes/nemotron35-lightning-nvfp4-dspark-rtx5090-c1.env — sourced by scripts/reproduce.sh on the pod.
# Nemotron 3.5 Lightning 30B-A3B NVFP4 + DSpark draft · vLLM 0.28.0 · 1x GeForce RTX 5090 · single stream — 681.5 tok/s, Verified, #1 single-stream on the NVFP4 board
# Measured run: results/nemotron35-lightning-nvfp4-dspark-rtx5090-c1/payload.json — https://www.localmaxxing.com/en/runs/cmtpif4s202qkn701l9rzs0ap  (Verified: yes)
# Consumer-hosted 5090 nodes: 21.6 GB (NVFP4) + 1.6 GB (DSpark drafter) downloaded at 10-30 MB/s (20-40 min); FlashInfer sm_120 JIT + CUDA graphs ~10 min on first start (SERVER_READY after 620 s in our log). --max-model-len 16384 / --max-num-seqs 8 fit the 32 GB card with the drafter.

RECIPE_TITLE="Nemotron 3.5 Lightning 30B-A3B NVFP4 + DSpark draft · vLLM 0.28.0 · 1x GeForce RTX 5090 · single stream — 681.5 tok/s, Verified, #1 single-stream on the NVFP4 board"
GPU=RTX5090                        # `lium up --gpu` value
GPU_PRICE_OBSERVED_USD_H=0.59          # what `lium ps` showed for this node on 6 Sep 2026
ENGINE=vllm                     # vllm | llama.cpp
HF_ID=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
SERVED_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
QUANT=NVFP4
MODELS="nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4 nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark"   # hf download targets: "org/repo" or "org/repo::<include-glob>"
CONCURRENCY=1
ITERATIONS=5                          # timed iterations (after 2 untimed warm-ups); median reported
MAX_TOKENS=1024
RUN_NAME=nemotron35-nvfp4-dspark__rtx5090x1__vllm__c1
MEASURED_TOKS_OUT=681.5                # our result, for the comparison line at the end
export MAX_JOBS=3 FLASHINFER_JIT_VERBOSE=0   # the 31 GB-RAM 5090 node OOM-killed the FlashInfer sm_120 JIT at default parallelism
# Serve line — VERBATIM from the measured run's payload (engineFlags.commandSnippet). For llama.cpp recipes these are the
# arguments passed to the official ghcr.io/ggml-org/llama.cpp:server-cuda container (reproduce.sh adds the docker run prefix).
read -r -d '' SERVE_CMD <<'SERVE' || true
vllm serve /workspace/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4 --served-model-name nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4 --host 127.0.0.1 --port 8000 --max-model-len 16384 --max-num-seqs 8 --gpu-memory-utilization 0.92 --enable-prefix-caching --async-scheduling --mamba-backend flashinfer --mamba-ssm-cache-dtype float16 --speculative-config '{"model":"/workspace/models/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4-DSpark","num_speculative_tokens":3}'
SERVE

# `notes` field submitted with the run — verbatim from the payload (reproduce.sh appends "reproduction" to it).
read -r -d '' NOTES <<'NOTES' || true
Rented 1x NVIDIA GeForce RTX 5090 (32 GB) on Lium (lium.io), PyTorch CUDA Ubuntu 24.04 template. vLLM 0.28.0, torch 2.13.0+cu130, official NVIDIA NVFP4 checkpoint + DSpark speculative-decoding draft (nvidia/...-NVFP4-DSpark, num_speculative_tokens 3; lossless), canonical LocalMaxxing reasoning-v1 prompt, greedy, batch 1, max_tokens 1024, 2 warmups + 5 timed iterations (median). Power = mean nvidia-smi power.draw over active samples of the timed window. Draft/accepted token counts from vLLM /metrics around the companion request.
NOTES
