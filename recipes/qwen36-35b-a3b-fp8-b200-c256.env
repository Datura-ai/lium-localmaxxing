# recipes/qwen36-35b-a3b-fp8-b200-c256.env — sourced by scripts/reproduce.sh on the pod.
# Qwen3.6-35B-A3B FP8 · vLLM 0.28.0 · 1x NVIDIA B200 · 256 concurrent streams (aggregate) — 14,499.4 tok/s, #1 of 276 on Qwen/Qwen3.6-35B-A3B
# Measured run: results/qwen36-35b-a3b-fp8-b200-c256/payload.json — https://www.localmaxxing.com/en/runs/cmtpc0w6f02hwn701n1g0v9cg  (Verified: no (aggregate rows are not badge-eligible: batch > 1))
# Datacenter node: 37.5 GB of weights downloaded in ~90 s; vLLM load + CUDA-graph capture ~3 min; the four runs (c1/c64/c128/c256) took 5 min. Whole 11-run session on this card: 40.5 min = $3.78.

RECIPE_TITLE="Qwen3.6-35B-A3B FP8 · vLLM 0.28.0 · 1x NVIDIA B200 · 256 concurrent streams (aggregate) — 14,499.4 tok/s, #1 of 276 on Qwen/Qwen3.6-35B-A3B"
GPU=B200                        # `lium up --gpu` value
GPU_PRICE_OBSERVED_USD_H=5.60          # what `lium ps` showed for this node on 6 Sep 2026
ENGINE=vllm                     # vllm | llama.cpp
HF_ID=Qwen/Qwen3.6-35B-A3B-FP8
SERVED_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
QUANT=FP8
MODELS="Qwen/Qwen3.6-35B-A3B-FP8"   # hf download targets: "org/repo" or "org/repo::<include-glob>"
CONCURRENCY=256
ITERATIONS=3                          # timed iterations (after 2 untimed warm-ups); median reported
MAX_TOKENS=512
RUN_NAME=q36a3b-fp8__b200x1__vllm__c256
MEASURED_TOKS_OUT=14499.4                # our result, for the comparison line at the end

# Serve line — VERBATIM from the measured run's payload (engineFlags.commandSnippet). For llama.cpp recipes these are the
# arguments passed to the official ghcr.io/ggml-org/llama.cpp:server-cuda container (reproduce.sh adds the docker run prefix).
read -r -d '' SERVE_CMD <<'SERVE' || true
vllm serve /workspace/models/Qwen3.6-35B-A3B-FP8 --served-model-name Qwen/Qwen3.6-35B-A3B-FP8 --host 127.0.0.1 --port 8000 --max-model-len 32768 --max-num-seqs 256 --gpu-memory-utilization 0.90 --enable-prefix-caching --limit-mm-per-prompt '{"image":0,"video":0}'
SERVE

# `notes` field submitted with the run — verbatim from the payload (reproduce.sh appends "reproduction" to it).
read -r -d '' NOTES <<'NOTES' || true
Rented 1x NVIDIA B200 (179 GB) on Lium (lium.io). vLLM 0.28.0 (torch 2.13+cu130), official Qwen FP8 checkpoint, --max-num-seqs 256, aggregate throughput at concurrency 256 x batch 1 (each request = canonical reasoning-v1 prompt with unique nonce, greedy, max_tokens 512), 2 warmups + 3 timed iterations (median). Power = mean nvidia-smi power.draw over active samples of the timed window.
NOTES
